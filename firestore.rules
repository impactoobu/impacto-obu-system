rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function profile(){ return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function sameAcademy(id){ return signedIn() && profile().academyId == id; }
    function admin(){ return signedIn() && profile().role == 'admin'; }
    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow read, update: if signedIn() && (request.auth.uid == uid || admin());
      allow delete: if admin();
    }
    match /students/{id} {
      allow read: if sameAcademy(resource.data.academyId);
      allow create: if sameAcademy(request.resource.data.academyId);
      allow update: if sameAcademy(resource.data.academyId);
      allow delete: if admin() && sameAcademy(resource.data.academyId);
    }
    match /attendance/{id} {
      allow read: if sameAcademy(resource.data.academyId);
      allow create: if sameAcademy(request.resource.data.academyId);
      allow update, delete: if admin() && sameAcademy(resource.data.academyId);
    }
  }
}
